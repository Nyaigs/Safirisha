generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                         String             @id @default(cuid())
  fullName                   String
  email                      String             @unique
  phone                      String             @unique
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt
  passwordHash               String
  role                       UserRole
  isActive                   Boolean            @default(true)
  suspendedAt                DateTime?
  suspensionReason           String?
  username                   String?            @unique
  isSuperAdmin               Boolean            @default(false)
  passwordResetCode          String?
  passwordResetCodeExpiresAt DateTime?
  passwordResetVerified      Boolean            @default(false)
  clerkId                    String?            @unique
  driverProfile              DriverProfile?
  customerRequests           TransportRequest[] @relation("CustomerRequests")

  @@index([role])
  @@index([isActive])
  @@index([isSuperAdmin])
}

model DriverProfile {
  id                String                  @id @default(cuid())
  userId            String                  @unique
  plateNumber       String?                 @unique
  vehicleType       String?
  vehicleImageUrl   String?
  ownershipProofUrl String?
  approvalStatus    DriverApprovalStatus    @default(PENDING)
  availability      DriverAvailability      @default(OFFLINE)
  currentLat        Float?
  currentLng        Float?
  currentHeading    Float?
  currentSpeed      Float?
  lastLocationAt    DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletionRequests  DriverDeletionRequest[]
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  acceptedRequests  TransportRequest[]      @relation("AssignedDriverRequests")

  @@index([approvalStatus])
  @@index([availability])
}

model TransportRequest {
  cancellationReason      String?
  cancelledBy             CancellationBy?
  cancellationFee         Float?
  scheduledFor            DateTime?              // <-- NEW
  id                     String         @id @default(cuid())
  customerId             String
  assignedDriverId       String?
  pickupAddress          String
  pickupLat              Float
  pickupLng              Float
  dropoffAddress         String
  dropoffLat             Float
  dropoffLng             Float
  vehicleType            String
  loadDescription        String?
  loadSize               String
  specialNotes           String?
  estimatedPrice         Float
  distanceKm             Float
  status                 RequestStatus  @default(REQUESTING)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  cashConfirmedByDriver  Boolean        @default(false)
  completedAt            DateTime?
  driverNetEarning       Float          @default(0)
  mpesaCheckoutRequestId String?
  mpesaReceiptNumber     String?
  paidAt                 DateTime?
  paymentMethod          PaymentMethod?
  paymentStatus          PaymentStatus  @default(UNPAID)
  platformFeeAmount      Float          @default(0)
  platformFeePercent     Float          @default(10)
  acceptedAt             DateTime?
  cancelledAt            DateTime?
  expiredAt              DateTime?
  expiresAt              DateTime?
  searchStartedAt        DateTime?
  pickupConfirmed        Boolean        @default(false)
  deliveryConfirmed      Boolean        @default(false)
  assignedDriver         DriverProfile? @relation("AssignedDriverRequests", fields: [assignedDriverId], references: [id])
  customer               User           @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
}

model DriverDeletionRequest {
  id                String                @id @default(cuid())
  driverId          String
  reason            String
  status            DeletionRequestStatus @default(PENDING)
  adminNote         String?
  scheduledDeletion DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  driver            DriverProfile         @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, status])
}

enum UserRole {
  CUSTOMER
  DRIVER
  ADMIN
}

enum DriverApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DriverAvailability {
  OFFLINE
  ONLINE
  BUSY
}

enum RequestStatus {
    REQUESTING
    SEARCHING
    SEARCHING_DRIVER
    ACCEPTED
    DRIVER_ASSIGNED
    DRIVER_EN_ROUTE
    DRIVER_ARRIVED
    ARRIVED_PICKUP
    PICKUP_CONFIRMED
    IN_TRANSIT
    ARRIVED_DROPOFF
    DELIVERY_CONFIRMED
    COMPLETED_PENDING_CONFIRMATION
    COMPLETED
    DELIVERED
    PAYMENT_PENDING
    CANCELLED
    SCHEDULED          // <-- NEW
}

enum PaymentMethod {
  CASH
  MPESA
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
}

enum DeletionRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CancellationBy {
  CUSTOMER
  DRIVER
}